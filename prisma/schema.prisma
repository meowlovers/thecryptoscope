generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Synced from Clerk on first login
model User {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  email         String         @unique
  createdAt     DateTime       @default(now())

  balance       Balance?
  transactions  Transaction[]
  orders        Order[]
  notifications Notification[]
}

// One balance row per user
model Balance {
  id        String   @id @default(cuid())
  userId    String   @unique
  amount    Float    @default(0) // USDT
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

// Every credit add or purchase deduction
model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float             // USDT
  status      TransactionStatus @default(PENDING)
  paymentId   String?           // NOWPayments payment ID
  note        String?
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id])
}

enum TransactionType {
  TOPUP
  PURCHASE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Analysis orders
model Order {
  id           String      @id @default(cuid())
  userId       String
  pair         String      // e.g. BTCUSDT
  analysisType String      // technical | fundamental | combined
  email        String
  notes        String?
  status       OrderStatus @default(PENDING)
  amountPaid   Float       // USDT
  pdfUrl       String?     // legacy PDF URL
  analysisId   String?     // link to rich analysis
  deliveredAt  DateTime?
  createdAt    DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id])
  analysis     Analysis?   @relation(fields: [analysisId], references: [id])
}

// Rich analysis content delivered to clients
model Analysis {
  id        String   @id @default(cuid())
  pair      String
  sections  Json     // AnalysisSection[]
  createdAt DateTime @default(now())
  orders    Order[]
}

// In-app notifications for users
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

// Support tickets from the contact page
model Ticket {
  id        String       @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}
